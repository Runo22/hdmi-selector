// Windows resource script: sets the application/executable icon.
// The resource is named "appicon" so it can be loaded cross-platform via the
// wxWidgets wxICON(appicon) macro (which maps to appicon_xpm elsewhere).
appicon ICON "app.ico"

// Declares per-monitor-v2 DPI awareness (see app.manifest). Without this,
// Windows bitmap-stretches the whole window instead of letting it redraw
// natively when it lands on a display with different scaling - the exact
// blurry/misrendered-text symptom seen after an exclusive switch moves the
// window onto a newly-sole-active display. CMake passes /MANIFEST:NO so the
// linker doesn't also try to generate/merge its own resource ID 1.
1 24 "app.manifest"
